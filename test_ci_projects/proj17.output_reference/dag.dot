digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    test_matrix___2_7__ubuntu_ [label="test:matrix: [2.7, ubuntu]", tooltip="---\nstage: test\nparallel:\n  instance: 1\n  total: 8\nscript:\n- echo \"Testing on Ruby ${RUBY_VERSION} with ${OS}\"\n- ruby --version\n- bundle install\n- bundle exec rspec\nvariables:\n  RUBY_VERSION: '2.7'\n  OS: ubuntu\n"];
