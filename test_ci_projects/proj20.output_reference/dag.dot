digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_prebuild {
    label="prebuild";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_prebuild [style=invis, width=0, height=0];

    validate_yaml [label="validate:yaml", tooltip="---\nstage: prebuild\nimage: alpine:latest\nscript:\n- apk add --no-cache yamllint\n- 'yamllint -d \"{extends: relaxed, rules: {line-length: {max: 120}}}\" .gitlab-ci.yml'\n- echo \"YAML validation passed\"\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
    validate_dependencies [label="validate:dependencies", tooltip="---\nstage: prebuild\nimage: alpine:latest\nscript:\n- echo \"Checking dependency files...\"\n- test -f package.json || echo \"Warning: package.json not found\"\n- test -f Gemfile || echo \"Warning: Gemfile not found\"\n- test -f requirements.txt || echo \"Warning: requirements.txt not found\"\n- echo \"Dependency validation complete\"\nrules:\n- if: \"$CI_COMMIT_BRANCH\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    test_matrix_compatibility [label="test:matrix:compatibility", tooltip="---\nstage: test\nparallel:\n  matrix:\n  - SERVICE:\n    - frontend\n    - backend\n    - api\n    ENV:\n    - development\n    - staging\n    RUNNER:\n    - linux\n    - alpine\nimage: alpine:latest\nneeds: []\nscript:\n- echo \"Testing ${SERVICE} on ${RUNNER} for ${ENV} environment\"\n- echo \"Service: ${SERVICE}\"\n- echo \"Environment: ${ENV}\"\n- echo \"Runner: ${RUNNER}\"\n- echo \"Compatibility test passed\"\nrules:\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
  }

  subgraph cluster_security {
    label="security";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_security [style=invis, width=0, height=0];

    audit_frontend_dependencies [label="audit:frontend:dependencies", tooltip="---\nimage: node:20-alpine\ncache:\n  key: frontend-deps-${CI_COMMIT_REF_SLUG}\n  paths:\n  - services/frontend/node_modules/\n  - services/frontend/.npm/\nbefore_script:\n- cd services/frontend\n- npm ci --cache .npm --prefer-offline\nstage: security\nneeds: []\nscript:\n- npm audit --audit-level=moderate\nallow_failure: true\nrules:\n- if: $CI_PIPELINE_SOURCE == \"schedule\"\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\n"];
    audit_backend_dependencies [label="audit:backend:dependencies", tooltip="---\nimage: ruby:3.2-alpine\ncache:\n  key: backend-gems-${CI_COMMIT_REF_SLUG}\n  paths:\n  - services/backend/vendor/bundle/\nbefore_script:\n- cd services/backend\n- bundle config set --local path 'vendor/bundle'\n- bundle install --jobs 4\nstage: security\nneeds: []\nscript:\n- bundle audit check --update\nallow_failure: true\nrules:\n- if: $CI_PIPELINE_SOURCE == \"schedule\"\n- if: $CI_COMMIT_BRANCH == \"main\"\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\n"];
    security_container_scan [label="security:container:scan", tooltip="---\nstage: security\nallow_failure: true\nartifacts:\n  expire_in: 1 week\n  paths:\n  - \"*-scan.json\"\nimage: aquasec/trivy:latest\nneeds: []\nparallel:\n  matrix:\n  - IMAGE:\n    - frontend\n    - backend\n    - api\n    - workers\nscript:\n- echo \"Scanning ${IMAGE} container image for vulnerabilities\"\n- trivy image --format json --output ${IMAGE}-scan.json ${DOCKER_IMAGE_BASE}/${IMAGE}:latest\n  || true\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\" && $CI_COMMIT_BRANCH == \"main\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
    security_license_check [label="security:license:check", tooltip="---\nstage: security\nallow_failure: true\nartifacts:\n  expire_in: 1 week\n  paths:\n  - license-report.json\nimage: licensefinder/license_finder:latest\nneeds: []\nscript:\n- license_finder report --format json > license-report.json || true\n- echo \"License compliance check completed\"\nrules:\n- if: $CI_PIPELINE_SOURCE == \"schedule\"\n- if: $CI_COMMIT_BRANCH == \"main\"\n  when: manual\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nwhen: manual\n"];
    security_sast [label="security:sast", tooltip="---\nstage: security\nimage: returntocorp/semgrep:latest\nneeds: []\nscript:\n- semgrep --config=auto --json --output=sast-report.json || true\n- echo \"SAST scan completed\"\nartifacts:\n  reports:\n    sast: sast-report.json\n  expire_in: 1 week\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
    security_dependency_scanning [label="security:dependency-scanning", tooltip="---\nstage: security\nimage: aquasec/trivy:latest\nneeds: []\nscript:\n- trivy fs --format json --output dependency-scan.json --severity HIGH,CRITICAL .\n  || true\n- echo \"Dependency scanning completed\"\nartifacts:\n  reports:\n    dependency_scanning: dependency-scan.json\n  expire_in: 1 week\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
    security_secrets [label="security:secrets", tooltip="---\nstage: security\nimage: trufflesecurity/trufflehog:latest\nneeds: []\nallow_failure: true\nscript:\n- trufflehog filesystem . --json > secrets-report.json || true\n- echo \"Secret scanning completed\"\nartifacts:\n  paths:\n  - secrets-report.json\n  expire_in: 1 week\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
  }

  subgraph cluster_quality {
    label="quality";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_quality [style=invis, width=0, height=0];

    quality_codeclimate [label="quality:codeclimate", tooltip="---\nstage: quality\nimage: codeclimate/codeclimate:latest\nneeds: []\nscript:\n- codeclimate analyze -f json > codeclimate-report.json || true\n- echo \"Code quality analysis completed\"\nartifacts:\n  reports:\n    codequality: codeclimate-report.json\n  expire_in: 1 week\nrules:\n- if: $ENABLE_CODE_QUALITY == \"true\"\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
  }

  subgraph cluster_cleanup {
    label="cleanup";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_cleanup [style=invis, width=0, height=0];

    cleanup_old_images [label="cleanup:old-images", tooltip="---\nstage: cleanup\nimage: alpine:latest\nneeds: []\nscript:\n- echo \"Cleaning up old Docker images...\"\n- echo \"Removing images older than 30 days\"\n- echo \"Cleanup completed\"\nrules:\n- if: $CI_COMMIT_BRANCH == \"main\"\n  when: manual\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nwhen: manual\n"];
    notify_pipeline_status [label="notify:pipeline-status", tooltip="---\nstage: cleanup\nimage: alpine:latest\nneeds: []\nscript:\n- echo \"================================================\"\n- echo \"Pipeline Summary\"\n- echo \"================================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Pipeline URL: ${CI_PIPELINE_URL}\"\n- echo \"Commit: ${CI_COMMIT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"================================================\"\n- |\n  if [ \"${CI_JOB_STATUS}\" = \"success\" ]; then\n    echo \"All pipeline jobs completed successfully!\"\n  else\n    echo \"Some pipeline jobs failed. Please review.\"\n  fi\nrules:\n- if: \"$CI_COMMIT_BRANCH\"\n  when: always\nbefore_script:\n- echo \"============================================\"\n- echo \"Pipeline ID: ${CI_PIPELINE_ID}\"\n- echo \"Job: ${CI_JOB_NAME}\"\n- echo \"Stage: ${CI_JOB_STAGE}\"\n- echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"\n- echo \"Branch: ${CI_COMMIT_REF_NAME}\"\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- echo \"Status: ${CI_JOB_STATUS}\"\n- echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nwhen: always\n"];
  }

}
