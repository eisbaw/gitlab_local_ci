digraph pipeline {
  rankdir="LR";
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_prebuild {
    label="prebuild";
    style=filled;
    fillcolor=lightgrey;

    validate_yaml [label="validate:yaml"];
    validate_dependencies [label="validate:dependencies"];
    lint_frontend [label="lint:frontend"];
    lint_backend [label="lint:backend"];
    lint_api [label="lint:api"];
  }

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    build_frontend [label="build:frontend"];
    build_backend [label="build:backend"];
    build_api [label="build:api"];
    build_workers [label="build:workers"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    _base_config [label=".base_config"];
    _docker_config [label=".docker_config"];
    _node_config [label=".node_config"];
    _ruby_config [label=".ruby_config"];
    _python_config [label=".python_config"];
    _base_job [label=".base_job"];
    _test_job [label=".test_job"];
    _deploy_job [label=".deploy_job"];
    test_frontend_unit [label="test:frontend:unit"];
    test_frontend_integration [label="test:frontend:integration"];
    test_backend_unit [label="test:backend:unit"];
    test_backend_integration [label="test:backend:integration"];
    test_api_unit [label="test:api:unit"];
    test_api_integration [label="test:api:integration"];
    test_workers [label="test:workers"];
    test_matrix_compatibility [label="test:matrix:compatibility"];
    package_frontend [label="package:frontend"];
    package_backend [label="package:backend"];
    package_api [label="package:api"];
    package_workers [label="package:workers"];
  }

  subgraph cluster_security {
    label="security";
    style=filled;
    fillcolor=lightgrey;

    security_sast [label="security:sast"];
    security_dependency_scanning [label="security:dependency-scanning"];
    security_secrets [label="security:secrets"];
  }

  subgraph cluster_quality {
    label="quality";
    style=filled;
    fillcolor=lightgrey;

    quality_codeclimate [label="quality:codeclimate"];
    quality_metrics [label="quality:metrics"];
  }

  subgraph cluster_package {
    label="package";
    style=filled;
    fillcolor=lightgrey;

    _docker_build_job [label=".docker_build_job"];
  }

  subgraph cluster_deploy_dev {
    label="deploy_dev";
    style=filled;
    fillcolor=lightgrey;

    deploy_dev_frontend [label="deploy:dev:frontend"];
    deploy_dev_backend [label="deploy:dev:backend"];
    deploy_dev_api [label="deploy:dev:api"];
    stop_dev_frontend [label="stop:dev:frontend"];
    stop_dev_backend [label="stop:dev:backend"];
    stop_dev_api [label="stop:dev:api"];
  }

  subgraph cluster_integration {
    label="integration";
    style=filled;
    fillcolor=lightgrey;

    integration_e2e [label="integration:e2e"];
  }

  subgraph cluster_deploy_stage {
    label="deploy_stage";
    style=filled;
    fillcolor=lightgrey;

    deploy_staging_frontend [label="deploy:staging:frontend"];
    deploy_staging_backend [label="deploy:staging:backend"];
    deploy_staging_api [label="deploy:staging:api"];
  }

  subgraph cluster_performance {
    label="performance";
    style=filled;
    fillcolor=lightgrey;

    performance_load_test [label="performance:load-test"];
    performance_stress_test [label="performance:stress-test"];
  }

  subgraph cluster_deploy_prod {
    label="deploy_prod";
    style=filled;
    fillcolor=lightgrey;

    deploy_prod_frontend [label="deploy:prod:frontend"];
    deploy_prod_backend [label="deploy:prod:backend"];
    deploy_prod_api [label="deploy:prod:api"];
    trigger_monitoring_setup [label="trigger:monitoring-setup"];
  }

  subgraph cluster_cleanup {
    label="cleanup";
    style=filled;
    fillcolor=lightgrey;

    cleanup_old_images [label="cleanup:old-images"];
    cleanup_artifacts [label="cleanup:artifacts"];
    notify_pipeline_status [label="notify:pipeline-status"];
  }

