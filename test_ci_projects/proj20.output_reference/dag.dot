digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_prebuild {
    label="prebuild";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_prebuild [style=invis, width=0, height=0];

    validate_yaml [label="validate:yaml", tooltip="---\nstage: prebuild\nimage: alpine:latest\nscript:\n- apk add --no-cache yamllint\n- 'yamllint -d \"{extends: relaxed, rules: {line-length: {max: 120}}}\" .gitlab-ci.yml'\n- echo \"YAML validation passed\"\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
    validate_dependencies [label="validate:dependencies", tooltip="---\nstage: prebuild\nimage: alpine:latest\nscript:\n- echo \"Checking dependency files...\"\n- 'test -f package.json || echo \"Warning: package.json not found\"'\n- 'test -f Gemfile || echo \"Warning: Gemfile not found\"'\n- 'test -f requirements.txt || echo \"Warning: requirements.txt not found\"'\n- echo \"Dependency validation complete\"\nrules:\n- if: \"$CI_COMMIT_BRANCH\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    test_matrix_compatibility___frontend__development__linux_ [label="test:matrix:compatibility: [frontend, development, linux]", tooltip="---\nstage: test\nparallel:\n  instance: 1\n  total: 12\nimage: alpine:latest\nneeds: []\nscript:\n- echo \"Testing ${SERVICE} on ${RUNNER} for ${ENV} environment\"\n- 'echo \"Service: ${SERVICE}\"'\n- 'echo \"Environment: ${ENV}\"'\n- 'echo \"Runner: ${RUNNER}\"'\n- echo \"Compatibility test passed\"\nrules:\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nvariables:\n  SERVICE: frontend\n  ENV: development\n  RUNNER: linux\n"];
    test_matrix_compatibility___frontend__development__alpine_ [label="test:matrix:compatibility: [frontend, development, alpine]", tooltip="---\nstage: test\nparallel:\n  instance: 2\n  total: 12\nimage: alpine:latest\nneeds: []\nscript:\n- echo \"Testing ${SERVICE} on ${RUNNER} for ${ENV} environment\"\n- 'echo \"Service: ${SERVICE}\"'\n- 'echo \"Environment: ${ENV}\"'\n- 'echo \"Runner: ${RUNNER}\"'\n- echo \"Compatibility test passed\"\nrules:\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nvariables:\n  SERVICE: frontend\n  ENV: development\n  RUNNER: alpine\n"];
