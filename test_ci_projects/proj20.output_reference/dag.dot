  subgraph cluster_security {
    label="security";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_security [style=invis, width=0, height=0];

    audit_frontend_dependencies [label="audit:frontend:dependencies", tooltip="---\nimage: node:20-alpine\ncache:\n  key: frontend-deps-${CI_COMMIT_REF_SLUG}\n  paths:\n  - services/frontend/node_modules/\n  - services/frontend/.npm/\nbefore_script:\n- cd services/frontend\n- npm ci --cache .npm --prefer-offline\nstage: security\nneeds: []\nscript:\n- npm audit --audit-level=moderate\nallow_failure: true\nrules:\n- if: $CI_PIPELINE_SOURCE == \"schedule\"\n- if: $CI_COMMIT_BRANCH == \"main\"\n- if: $CI_COMMIT_BRANCH == \"develop\"\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\n"];
    audit_backend_dependencies [label="audit:backend:dependencies", tooltip="---\nimage: ruby:3.2-alpine\ncache:\n  key: backend-gems-${CI_COMMIT_REF_SLUG}\n  paths:\n  - services/backend/vendor/bundle/\nbefore_script:\n- cd services/backend\n- bundle config set --local path 'vendor/bundle'\n- bundle install --jobs 4\nstage: security\nneeds: []\nscript:\n- bundle audit check --update\nallow_failure: true\nrules:\n- if: $CI_PIPELINE_SOURCE == \"schedule\"\n- if: $CI_COMMIT_BRANCH == \"main\"\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\n"];
    security_container_scan___frontend_ [label="security:container:scan: [frontend]", tooltip="---\nstage: security\nallow_failure: true\nartifacts:\n  expire_in: 1 week\n  paths:\n  - \"*-scan.json\"\nimage: aquasec/trivy:latest\nneeds: []\nparallel:\n  instance: 1\n  total: 4\nscript:\n- echo \"Scanning ${IMAGE} container image for vulnerabilities\"\n- trivy image --format json --output ${IMAGE}-scan.json ${DOCKER_IMAGE_BASE}/${IMAGE}:latest\n  || true\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\" && $CI_COMMIT_BRANCH == \"main\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nvariables:\n  IMAGE: frontend\n"];
    security_container_scan___backend_ [label="security:container:scan: [backend]", tooltip="---\nstage: security\nallow_failure: true\nartifacts:\n  expire_in: 1 week\n  paths:\n  - \"*-scan.json\"\nimage: aquasec/trivy:latest\nneeds: []\nparallel:\n  instance: 2\n  total: 4\nscript:\n- echo \"Scanning ${IMAGE} container image for vulnerabilities\"\n- trivy image --format json --output ${IMAGE}-scan.json ${DOCKER_IMAGE_BASE}/${IMAGE}:latest\n  || true\nrules:\n- if: $ENABLE_SECURITY_SCANNING == \"true\" && $CI_COMMIT_BRANCH == \"main\"\nbefore_script:\n- echo \"============================================\"\n- 'echo \"Pipeline ID: ${CI_PIPELINE_ID}\"'\n- 'echo \"Job: ${CI_JOB_NAME}\"'\n- 'echo \"Stage: ${CI_JOB_STAGE}\"'\n- 'echo \"Commit: ${CI_COMMIT_SHORT_SHA}\"'\n- 'echo \"Branch: ${CI_COMMIT_REF_NAME}\"'\n- echo \"============================================\"\n- export BUILD_TIMESTAMP=$(date +%s)\nafter_script:\n- echo \"============================================\"\n- echo \"Job ${CI_JOB_NAME} completed\"\n- 'echo \"Status: ${CI_JOB_STATUS}\"'\n- 'echo \"Duration: $(($(date +%s) - BUILD_TIMESTAMP)) seconds\"'\n- echo \"============================================\"\ncache:\n  key: global-${CI_COMMIT_REF_SLUG}\n  paths:\n  - \".cache/\"\n  - tmp/\n  policy: pull-push\nvariables:\n  IMAGE: backend\n"];
