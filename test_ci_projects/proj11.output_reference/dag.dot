digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_build [style=invis, width=0, height=0];

    build_app [label="build-app", tooltip="---\nstage: build\nbefore_script:\n- echo \"Preparing build environment...\"\nartifacts:\n  paths:\n  - build/\n  expire_in: 1 hour\nscript:\n- echo \"Building application with overrides...\"\n- 'echo \"Build type: ${BUILD_TYPE}\"'\n- mkdir -p build\n- echo \"app-v${VERSION}-optimized\" > build/app.txt\n- echo \"Build completed with custom configuration\"\nvariables:\n  BUILD_TYPE: optimized\nafter_script:\n- echo \"Custom post-build step\"\n- ls -la build/\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    build_docker [label="build-docker", tooltip="---\nstage: build\nbefore_script:\n- echo \"Preparing build environment...\"\nartifacts:\n  paths:\n  - build/\n  expire_in: 1 hour\nscript:\n- echo \"Building Docker image...\"\n- mkdir -p build\n- echo \"docker-image:latest\" > build/docker.txt\n- echo \"Docker build completed\"\nonly:\n- main\n- develop\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    unit_tests [label="unit-tests", tooltip="---\nstage: test\nbefore_script:\n- echo \"Setting up test environment...\"\nscript:\n- echo \"Running unit tests...\"\n- 'echo \"Test suite: Unit Tests\"'\n- 'echo \"Tests passed: 150/150\"'\n- 'echo \"Coverage: 85%\"'\ndependencies:\n- build-app\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    integration_tests [label="integration-tests", tooltip="---\nstage: test\nbefore_script:\n- echo \"Setting up test environment...\"\nscript:\n- echo \"Running integration tests (with override)...\"\n- 'echo \"Test suite: Integration Tests (Extended)\"'\n- echo \"Running additional smoke tests...\"\n- 'echo \"Tests passed: 50/50\"'\n- echo \"All integration tests passed\"\ndependencies:\n- build-app\nallow_failure: true\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    security_scan [label="security-scan", tooltip="---\nstage: test\nbefore_script:\n- echo \"Setting up test environment...\"\nscript:\n- echo \"Running security scan...\"\n- echo \"Scanning for vulnerabilities...\"\n- echo \"No critical vulnerabilities found\"\nallow_failure: true\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    code_quality [label="code-quality", tooltip="---\nstage: test\nscript:\n- echo \"Running code quality checks...\"\n- echo \"Analyzing code style...\"\n- echo \"Checking for code smells...\"\n- 'echo \"Quality score: A+\"'\ndependencies:\n- build-app\nallow_failure: true\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
  }

  subgraph cluster_deploy {
    label="deploy";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_deploy [style=invis, width=0, height=0];

    deploy_staging [label="deploy-staging", tooltip="---\nstage: deploy\nbefore_script:\n- echo \"Preparing deployment...\"\nwhen: manual\nonly:\n- develop\nscript:\n- echo \"Deploying to staging environment...\"\n- 'echo \"Target: staging.example.com\"'\n- echo \"Deployment completed\"\nenvironment:\n  name: staging\n  url: https://staging.example.com\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    deploy_production [label="deploy-production", tooltip="---\nstage: deploy\nbefore_script:\n- echo \"Preparing production deployment with extra checks...\"\n- echo \"Verifying all tests passed...\"\n- echo \"Checking deployment prerequisites...\"\nwhen: manual\nonly:\n- main\nscript:\n- echo \"Deploying to production environment (verified)...\"\n- 'echo \"Target: www.example.com\"'\n- echo \"Running pre-deployment health checks...\"\n- echo \"Production deployment completed successfully\"\nenvironment:\n  name: production\n  url: https://www.example.com\nafter_script:\n- echo \"Running post-deployment verification...\"\n- echo \"Sending deployment notification...\"\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
    rollback_production [label="rollback-production", tooltip="---\nstage: deploy\nscript:\n- echo \"Rolling back production deployment...\"\n- echo \"Restoring previous version...\"\n- echo \"Rollback completed\"\nenvironment:\n  name: production\n  action: rollback\nwhen: manual\nonly:\n- main\nretry:\n  max: 2\n  when:\n  - runner_system_failure\n  - stuck_or_timeout_failure\n"];
  }

  __stage_anchor_build -> unit_tests [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> integration_tests [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> security_scan [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_test -> deploy_staging [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_test -> deploy_production [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_test -> rollback_production [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_build -> code_quality [ltail=cluster_build, style=bold, color="#E41A1C"];
}
