digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_build [style=invis, width=0, height=0];

    build_simple [label="build_simple", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- build\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Build template before_script\"\n- apk add --no-cache build-base git\nstage: build\nscript:\n- echo \"Building simple application\"\n- mkdir -p build\n- echo \"binary\" > build/app\nartifacts:\n  paths:\n  - build/\n  expire_in: 1 hour\n"];
    build_complex [label="build_complex", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- build\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Build template before_script\"\n- apk add --no-cache build-base git\nstage: build\nscript:\n- echo \"Building complex application with optimizations\"\n- echo \"BUILD_ENV=$BUILD_ENV\"\n- mkdir -p build\n- echo \"optimized_binary\" > build/app_optimized\nartifacts:\n  paths:\n  - build/\n  expire_in: 2 hours\nvariables:\n  BUILD_ENV: production\n  OPTIMIZATION_LEVEL: '3'\n"];
    build_advanced [label="build_advanced", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- build\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Build template before_script\"\n- apk add --no-cache build-base git\nstage: build\nscript:\n- echo \"Building with advanced template\"\n- echo \"BUILD_TYPE=$BUILD_TYPE\"\n- echo \"OPTIMIZATION=$OPTIMIZATION\"\n- mkdir -p build\n- echo \"advanced_binary\" > build/app_advanced\nartifacts:\n  paths:\n  - build/\n  expire_in: 1 hour\nvariables:\n  BUILD_TYPE: super_advanced\n  OPTIMIZATION: enabled\n  EXTRA_FLAGS: \"--strict\"\nafter_script:\n- echo \"Advanced build cleanup\"\n- rm -rf /tmp/*\n"];
    build_no_retry [label="build_no_retry", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- build\nretry: 0\nbefore_script:\n- echo \"Build template before_script\"\n- apk add --no-cache build-base git\nstage: build\nscript:\n- echo \"Building without retry capability\"\n- mkdir -p build\n- echo \"no_retry_binary\" > build/app_no_retry\nartifacts:\n  paths:\n  - build/\n  expire_in: 1 hour\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    test_unit [label="test_unit", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- test\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Test template before_script\"\n- apk add --no-cache python3 py3-pip\nstage: test\nscript:\n- echo \"Running unit tests\"\n- python3 -c \"print('All unit tests passed')\"\ncoverage: \"/TOTAL.*\\\\s+(\\\\d+%)$/\"\ndependencies:\n- build_simple\n"];
    test_integration [label="test_integration", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- test\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Test template before_script\"\n- apk add --no-cache python3 py3-pip\nstage: test\nscript:\n- echo \"Running integration tests\"\n- echo \"Coverage: 85.5%\"\ncoverage: \"/Coverage:\\\\s+(\\\\d+\\\\.\\\\d+%)/\"\ndependencies:\n- build_complex\n"];
    test_e2e [label="test_e2e", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- test\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"E2E specific setup - replaces template before_script\"\n- apk add --no-cache chromium chromium-chromedriver\nstage: test\nscript:\n- echo \"Running end-to-end tests\"\n- echo \"Browser tests completed\"\ncoverage: \"/TOTAL.*\\\\s+(\\\\d+%)$/\"\ndependencies:\n- build_advanced\n"];
    test_security [label="test_security", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- test\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Test template before_script\"\n- apk add --no-cache python3 py3-pip\nstage: test\nscript:\n- echo \"Running security scans\"\n- echo \"Vulnerability check passed\"\ncoverage: \"/TOTAL.*\\\\s+(\\\\d+%)$/\"\nallow_failure: true\ntimeout: 30m\nrules:\n- if: $CI_COMMIT_BRANCH == \"master\"\n  when: always\n- when: manual\nwhen: manual\n"];
  }

  subgraph cluster_deploy {
    label="deploy";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_deploy [style=invis, width=0, height=0];

    deploy_staging [label="deploy_staging", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- deploy\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Deploy template before_script\"\n- apk add --no-cache openssh-client\nstage: deploy\nonly:\n- develop\n- \"/^feature\\\\/.*$/\"\nenvironment:\n  name: staging\n  url: https://staging.example.com\nscript:\n- echo \"Deploying to staging environment\"\n- echo \"Deployment successful\"\n"];
    deploy_production [label="deploy_production", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- deploy\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Production deploy setup\"\n- apk add --no-cache openssh-client aws-cli\nstage: deploy\nonly:\n- master\nenvironment:\n  name: production\n  url: https://example.com\nvariables:\n  DEPLOY_STRATEGY: blue-green\n  HEALTH_CHECK_TIMEOUT: '300'\nscript:\n- echo \"Deploying to production with $DEPLOY_STRATEGY strategy\"\n- echo \"Running health checks\"\n- echo \"Production deployment successful\"\nwhen: manual\n"];
    deploy_canary [label="deploy_canary", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n- deploy\nretry:\n  max: 2\n  when:\n  - runner_system_failure\nbefore_script:\n- echo \"Deploy template before_script\"\n- apk add --no-cache openssh-client\nstage: deploy\nonly:\n- main\n- master\nenvironment:\n  name: production-canary\n  url: https://canary.example.com\nvariables:\n  DEPLOY_STRATEGY: canary\n  CANARY_PERCENTAGE: '10'\nscript:\n- echo \"Deploying canary release\"\n- echo \"Canary percentage: $CANARY_PERCENTAGE%\"\nwhen: manual\nallow_failure: true\n"];
  }

  __stage_anchor_build -> test_unit [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_integration [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_e2e [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_test -> deploy_staging [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_test -> deploy_production [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_test -> deploy_canary [ltail=cluster_test, style=bold, color="#377EB8"];
  __stage_anchor_build -> test_security [ltail=cluster_build, style=bold, color="#E41A1C"];
}
