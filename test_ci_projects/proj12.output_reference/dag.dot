digraph pipeline {
  rankdir="LR";
  ranksep=2;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    _build_job_base [label=".build_job_base", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\nstage: build\nvariables:\n  BUILD_ENV: 'true'\n"];
    build_app [label="build:app", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\nstage: build\nvariables:\n  BUILD_ENV: 'true'\nscript:\n- echo \"Building application...\"\n- mkdir -p build\n- echo \"app build\" > build/app.txt\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n- if: \"$CI_COMMIT_TAG\"\n"];
    build_library [label="build:library", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\nstage: build\nvariables:\n  BUILD_TYPE: library\nscript:\n- echo \"Building library...\"\n- mkdir -p build\n- echo \"lib build\" > build/lib.txt\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n- if: \"$CI_COMMIT_TAG\"\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    _base_config [label=".base_config", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\n"];
    _docker_config [label=".docker_config", tooltip="---\nimage: alpine:latest\ntags:\n- docker\n"];
    _cache_config [label=".cache_config", tooltip="---\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\n"];
    _artifacts_config [label=".artifacts_config", tooltip="---\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\n"];
    _base_job [label=".base_job", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\n"];
    _test_job_base [label=".test_job_base", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n"];
    _on_merge_request [label=".on_merge_request", tooltip="---\nif: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n"];
    _on_main_branch [label=".on_main_branch", tooltip="---\nif: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n"];
    _rule_set_standard [label=".rule_set_standard", tooltip="---\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n- if: \"$CI_COMMIT_TAG\"\n"];
    test_unit [label="test:unit", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running unit tests...\"\n- echo \"All unit tests passed\"\ncoverage: \"/Coverage: \\\\d+\\\\.\\\\d+%/\"\n"];
    security_scan [label="security:scan", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: aquasec/trivy:latest\nstage: test\nscript:\n- echo \"Running security scan...\"\n- echo \"Security scan completed\"\nallow_failure: true\n"];
    _complex_matrix [label=".complex_matrix", tooltip="---\nparallel:\n  matrix:\n  - PLATFORM:\n    - linux\n    - macos\n    - windows\n    VERSION:\n    - '3.9'\n    - '3.10'\n    - '3.11'\n"];
    test_matrix [label="test:matrix", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\nparallel:\n  matrix:\n  - PLATFORM:\n    - linux\n    - macos\n    - windows\n    VERSION:\n    - '3.9'\n    - '3.10'\n    - '3.11'\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
  }

  subgraph cluster_integration {
    label="integration";
    style=filled;
    fillcolor=lightgrey;

    test_integration [label="test:integration", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: integration\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running integration tests...\"\n- echo \"Integration tests completed\"\ndependencies:\n- build:app\n"];
    test_e2e [label="test:e2e", tooltip="---\nretry: 3\ntimeout: 30m\ninterruptible: true\nimage: cypress/base:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: integration\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running E2E tests...\"\n- echo \"E2E tests completed\"\ndependencies:\n- build:app\n- build:library\n"];
  }

  subgraph cluster_deploy {
    label="deploy";
    style=filled;
    fillcolor=lightgrey;

    deploy_staging [label="deploy:staging", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\nstage: deploy\nscript:\n- echo \"Deploying to staging...\"\n- echo \"Staging deployment complete\"\nenvironment:\n  name: staging\n  url: https://staging.example.com\nonly:\n- main\ndependencies:\n- build:app\n"];
    deploy_production [label="deploy:production", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- - apk add --no-cache git curl bash\n  - echo \"Dependencies installed\"\n- - export PATH=\"$PATH:/usr/local/bin\"\n  - echo \"Environment configured\"\nstage: deploy\nscript:\n- echo \"Deploying to production...\"\n- echo \"Production deployment complete\"\nenvironment:\n  name: production\n  url: https://production.example.com\nwhen: manual\nonly:\n- tags\ndependencies:\n- build:app\n- build:library\n"];
  }

  _build_job_base -> _base_config;
  build_app -> _base_config;
  build_library -> _base_config;
  _build_job_base -> _docker_config;
  build_app -> _docker_config;
  build_library -> _docker_config;
  _build_job_base -> _cache_config;
  build_app -> _cache_config;
  build_library -> _cache_config;
  _build_job_base -> _artifacts_config;
  build_app -> _artifacts_config;
  build_library -> _artifacts_config;
  _build_job_base -> _base_job;
  build_app -> _base_job;
  build_library -> _base_job;
  _build_job_base -> _test_job_base;
  build_app -> _test_job_base;
  build_library -> _test_job_base;
  _build_job_base -> _on_merge_request;
  build_app -> _on_merge_request;
  build_library -> _on_merge_request;
  _build_job_base -> _on_main_branch;
  build_app -> _on_main_branch;
  build_library -> _on_main_branch;
  _build_job_base -> _rule_set_standard;
  build_app -> _rule_set_standard;
  build_library -> _rule_set_standard;
  _build_job_base -> test_unit;
  build_app -> test_unit;
  build_library -> test_unit;
  _base_config -> test_integration;
  _docker_config -> test_integration;
  _cache_config -> test_integration;
  _artifacts_config -> test_integration;
  _base_job -> test_integration;
  _test_job_base -> test_integration;
  _build_job_base -> test_integration;
  _on_merge_request -> test_integration;
  _on_main_branch -> test_integration;
  _rule_set_standard -> test_integration;
  build_app -> test_integration;
  build_library -> test_integration;
  test_unit -> test_integration;
  security_scan -> test_integration;
  _complex_matrix -> test_integration;
  test_matrix -> test_integration;
  _base_config -> test_e2e;
  _docker_config -> test_e2e;
  _cache_config -> test_e2e;
  _artifacts_config -> test_e2e;
  _base_job -> test_e2e;
  _test_job_base -> test_e2e;
  _build_job_base -> test_e2e;
  _on_merge_request -> test_e2e;
  _on_main_branch -> test_e2e;
  _rule_set_standard -> test_e2e;
  build_app -> test_e2e;
  build_library -> test_e2e;
  test_unit -> test_e2e;
  security_scan -> test_e2e;
  _complex_matrix -> test_e2e;
  test_matrix -> test_e2e;
  _base_config -> deploy_staging;
  _docker_config -> deploy_staging;
  _cache_config -> deploy_staging;
  _artifacts_config -> deploy_staging;
  _base_job -> deploy_staging;
  _test_job_base -> deploy_staging;
  _build_job_base -> deploy_staging;
  _on_merge_request -> deploy_staging;
  _on_main_branch -> deploy_staging;
  _rule_set_standard -> deploy_staging;
  build_app -> deploy_staging;
  build_library -> deploy_staging;
  test_unit -> deploy_staging;
  test_integration -> deploy_staging;
  test_e2e -> deploy_staging;
  security_scan -> deploy_staging;
  _complex_matrix -> deploy_staging;
  test_matrix -> deploy_staging;
  _base_config -> deploy_production;
  _docker_config -> deploy_production;
  _cache_config -> deploy_production;
  _artifacts_config -> deploy_production;
  _base_job -> deploy_production;
  _test_job_base -> deploy_production;
  _build_job_base -> deploy_production;
  _on_merge_request -> deploy_production;
  _on_main_branch -> deploy_production;
  _rule_set_standard -> deploy_production;
  build_app -> deploy_production;
  build_library -> deploy_production;
  test_unit -> deploy_production;
  test_integration -> deploy_production;
  test_e2e -> deploy_production;
  security_scan -> deploy_production;
  _complex_matrix -> deploy_production;
  test_matrix -> deploy_production;
  _build_job_base -> security_scan;
  build_app -> security_scan;
  build_library -> security_scan;
  _build_job_base -> _complex_matrix;
  build_app -> _complex_matrix;
  build_library -> _complex_matrix;
  _build_job_base -> test_matrix;
  build_app -> test_matrix;
  build_library -> test_matrix;
}
