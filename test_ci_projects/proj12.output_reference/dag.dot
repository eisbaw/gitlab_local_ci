digraph pipeline {
  rankdir="LR";
  ranksep=2;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_build [style=invis, width=0, height=0];

    build_app [label="build:app", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\nstage: build\nvariables:\n  BUILD_ENV: 'true'\nscript:\n- echo \"Building application...\"\n- mkdir -p build\n- echo \"app build\" > build/app.txt\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n- if: \"$CI_COMMIT_TAG\"\n"];
    build_library [label="build:library", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\nartifacts:\n  expire_in: 1 week\n  paths:\n  - build/\n  - dist/\nstage: build\nvariables:\n  BUILD_TYPE: library\nscript:\n- echo \"Building library...\"\n- mkdir -p build\n- echo \"lib build\" > build/lib.txt\nrules:\n- if: $CI_PIPELINE_SOURCE == \"merge_request_event\"\n- if: $CI_COMMIT_BRANCH == \"main\" || $CI_COMMIT_BRANCH == \"master\"\n- if: \"$CI_COMMIT_TAG\"\n"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_test [style=invis, width=0, height=0];

    test_unit [label="test:unit", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running unit tests...\"\n- echo \"All unit tests passed\"\ncoverage: \"/Coverage: \\\\d+\\\\.\\\\d+%/\"\n"];
    security_scan [label="security:scan", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: aquasec/trivy:latest\nstage: test\nscript:\n- echo \"Running security scan...\"\n- echo \"Security scan completed\"\nallow_failure: true\n"];
    test_matrix___linux__3_9_ [label="test:matrix: [linux, 3.9]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: linux\n  VERSION: '3.9'\nparallel:\n  instance: 1\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___linux__3_10_ [label="test:matrix: [linux, 3.10]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: linux\n  VERSION: '3.10'\nparallel:\n  instance: 2\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___linux__3_11_ [label="test:matrix: [linux, 3.11]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: linux\n  VERSION: '3.11'\nparallel:\n  instance: 3\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___macos__3_9_ [label="test:matrix: [macos, 3.9]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: macos\n  VERSION: '3.9'\nparallel:\n  instance: 4\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___macos__3_10_ [label="test:matrix: [macos, 3.10]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: macos\n  VERSION: '3.10'\nparallel:\n  instance: 5\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___macos__3_11_ [label="test:matrix: [macos, 3.11]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: macos\n  VERSION: '3.11'\nparallel:\n  instance: 6\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___windows__3_9_ [label="test:matrix: [windows, 3.9]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: windows\n  VERSION: '3.9'\nparallel:\n  instance: 7\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___windows__3_10_ [label="test:matrix: [windows, 3.10]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: windows\n  VERSION: '3.10'\nparallel:\n  instance: 8\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
    test_matrix___windows__3_11_ [label="test:matrix: [windows, 3.11]", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: test\nvariables:\n  TEST_ENV: 'true'\n  PLATFORM: windows\n  VERSION: '3.11'\nparallel:\n  instance: 9\n  total: 9\nscript:\n- echo \"Testing on ${PLATFORM} with version ${VERSION}\"\n- echo \"Matrix test completed\"\n"];
  }

  subgraph cluster_integration {
    label="integration";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_integration [style=invis, width=0, height=0];

    test_integration [label="test:integration", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: integration\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running integration tests...\"\n- echo \"Integration tests completed\"\ndependencies:\n- build:app\n"];
    test_e2e [label="test:e2e", tooltip="---\nretry: 3\ntimeout: 30m\ninterruptible: true\nimage: cypress/base:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\ncache:\n  key: \"${CI_COMMIT_REF_SLUG}\"\n  paths:\n  - \".cache/\"\n  - vendor/\nstage: integration\nvariables:\n  TEST_ENV: 'true'\nscript:\n- echo \"Running E2E tests...\"\n- echo \"E2E tests completed\"\ndependencies:\n- build:app\n- build:library\n"];
  }

  subgraph cluster_deploy {
    label="deploy";
    style=filled;
    fillcolor=lightgrey;

    __stage_anchor_deploy [style=invis, width=0, height=0];

    deploy_staging [label="deploy:staging", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\nstage: deploy\nscript:\n- echo \"Deploying to staging...\"\n- echo \"Staging deployment complete\"\nenvironment:\n  name: staging\n  url: https://staging.example.com\nonly:\n- main\ndependencies:\n- build:app\n"];
    deploy_production [label="deploy:production", tooltip="---\nretry: 2\ntimeout: 30m\ninterruptible: true\nimage: alpine:latest\ntags:\n- docker\nbefore_script:\n- apk add --no-cache git curl bash\n- echo \"Dependencies installed\"\n- export PATH=\"$PATH:/usr/local/bin\"\n- echo \"Environment configured\"\nstage: deploy\nscript:\n- echo \"Deploying to production...\"\n- echo \"Production deployment complete\"\nenvironment:\n  name: production\n  url: https://production.example.com\nwhen: manual\nonly:\n- tags\ndependencies:\n- build:app\n- build:library\n"];
  }

  __stage_anchor_build -> test_unit [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_test -> test_integration [ltail=cluster_test, style=bold, color="#4DAF4A"];
  __stage_anchor_test -> test_e2e [ltail=cluster_test, style=bold, color="#4DAF4A"];
  __stage_anchor_integration -> deploy_staging [ltail=cluster_integration, style=bold, color="#377EB8"];
  __stage_anchor_integration -> deploy_production [ltail=cluster_integration, style=bold, color="#377EB8"];
  __stage_anchor_build -> security_scan [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___linux__3_9_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___linux__3_10_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___linux__3_11_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___macos__3_9_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___macos__3_10_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___macos__3_11_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___windows__3_9_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___windows__3_10_ [ltail=cluster_build, style=bold, color="#E41A1C"];
  __stage_anchor_build -> test_matrix___windows__3_11_ [ltail=cluster_build, style=bold, color="#E41A1C"];
}
