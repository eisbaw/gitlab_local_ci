digraph pipeline {
  rankdir="LR";
  node [shape=box, style=filled, fillcolor=lightblue];

  subgraph cluster_build {
    label="build";
    style=filled;
    fillcolor=lightgrey;

    build_main [label="build_main"];
    build_feature [label="build_feature"];
    nightly_build [label="nightly_build"];
  }

  subgraph cluster_test {
    label="test";
    style=filled;
    fillcolor=lightgrey;

    test_mr [label="test_mr"];
    test_comprehensive [label="test_comprehensive"];
    test_backend [label="test_backend"];
    test_frontend [label="test_frontend"];
    security_scan [label="security_scan"];
    experimental_test [label="experimental_test"];
    integration_test [label="integration_test"];
    skip_on_draft [label="skip_on_draft"];
  }

  subgraph cluster_deploy {
    label="deploy";
    style=filled;
    fillcolor=lightgrey;

    deploy_staging [label="deploy_staging"];
    deploy_production [label="deploy_production"];
    notify_success [label="notify_success"];
    release [label="release"];
    deploy_custom [label="deploy_custom"];
  }

  subgraph cluster_cleanup {
    label="cleanup";
    style=filled;
    fillcolor=lightgrey;

    notify_failure [label="notify_failure"];
    cleanup_always [label="cleanup_always"];
  }

  build_main -> test_mr;
  build_feature -> test_mr;
  nightly_build -> test_mr;
  build_main -> test_comprehensive;
  build_feature -> test_comprehensive;
  nightly_build -> test_comprehensive;
  build_main -> test_backend;
  build_feature -> test_backend;
  nightly_build -> test_backend;
  build_main -> test_frontend;
  build_feature -> test_frontend;
  nightly_build -> test_frontend;
  build_main -> deploy_staging;
  build_feature -> deploy_staging;
  test_mr -> deploy_staging;
  test_comprehensive -> deploy_staging;
  test_backend -> deploy_staging;
  test_frontend -> deploy_staging;
  security_scan -> deploy_staging;
  experimental_test -> deploy_staging;
  nightly_build -> deploy_staging;
  integration_test -> deploy_staging;
  skip_on_draft -> deploy_staging;
  build_main -> deploy_production;
  build_feature -> deploy_production;
  test_mr -> deploy_production;
  test_comprehensive -> deploy_production;
  test_backend -> deploy_production;
  test_frontend -> deploy_production;
  security_scan -> deploy_production;
  experimental_test -> deploy_production;
  nightly_build -> deploy_production;
  integration_test -> deploy_production;
  skip_on_draft -> deploy_production;
  build_main -> notify_success;
  build_feature -> notify_success;
  test_mr -> notify_success;
  test_comprehensive -> notify_success;
  test_backend -> notify_success;
  test_frontend -> notify_success;
  security_scan -> notify_success;
  experimental_test -> notify_success;
  nightly_build -> notify_success;
  integration_test -> notify_success;
  skip_on_draft -> notify_success;
  build_main -> notify_failure;
  build_feature -> notify_failure;
  test_mr -> notify_failure;
  test_comprehensive -> notify_failure;
  test_backend -> notify_failure;
  test_frontend -> notify_failure;
  deploy_staging -> notify_failure;
  deploy_production -> notify_failure;
  notify_success -> notify_failure;
  security_scan -> notify_failure;
  release -> notify_failure;
  experimental_test -> notify_failure;
  nightly_build -> notify_failure;
  deploy_custom -> notify_failure;
  integration_test -> notify_failure;
  skip_on_draft -> notify_failure;
  build_main -> cleanup_always;
  build_feature -> cleanup_always;
  test_mr -> cleanup_always;
  test_comprehensive -> cleanup_always;
  test_backend -> cleanup_always;
  test_frontend -> cleanup_always;
  deploy_staging -> cleanup_always;
  deploy_production -> cleanup_always;
  notify_success -> cleanup_always;
  security_scan -> cleanup_always;
  release -> cleanup_always;
  experimental_test -> cleanup_always;
  nightly_build -> cleanup_always;
  deploy_custom -> cleanup_always;
  integration_test -> cleanup_always;
  skip_on_draft -> cleanup_always;
  build_main -> security_scan;
  build_feature -> security_scan;
  nightly_build -> security_scan;
  build_main -> release;
  build_feature -> release;
  test_mr -> release;
  test_comprehensive -> release;
  test_backend -> release;
  test_frontend -> release;
  security_scan -> release;
  experimental_test -> release;
  nightly_build -> release;
  integration_test -> release;
  skip_on_draft -> release;
  build_main -> experimental_test;
  build_feature -> experimental_test;
  nightly_build -> experimental_test;
  build_main -> deploy_custom;
  build_feature -> deploy_custom;
  test_mr -> deploy_custom;
  test_comprehensive -> deploy_custom;
  test_backend -> deploy_custom;
  test_frontend -> deploy_custom;
  security_scan -> deploy_custom;
  experimental_test -> deploy_custom;
  nightly_build -> deploy_custom;
  integration_test -> deploy_custom;
  skip_on_draft -> deploy_custom;
  build_main -> integration_test;
  build_feature -> integration_test;
  nightly_build -> integration_test;
  build_main -> skip_on_draft;
  build_feature -> skip_on_draft;
  nightly_build -> skip_on_draft;
}
